          "y": 100.0,
          "surfaceWidth": 400.0,
          "surfaceHeight": 400.0,
          "expect": [
            200.0,
            100.0
          ]
        },
        {
          "op": "setTrigger",
          "stateMachineId": "machine-button",
          "inputName": "press"
        },
        {
          "op": "advance",
          "deltaSeconds": 0.016
        },
        {
          "op": "expectTakeFiredAudioEvents",
          "expect": [
            "event-click"
          ]
        },
        {
          "op": "expectTakeFiredAudioEvents",
          "expect": []
        }
      ],
      "expect": {
        "loads": true
      }
