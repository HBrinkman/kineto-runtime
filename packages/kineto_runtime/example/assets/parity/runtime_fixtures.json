    {
      "id": "layers_body_face_mouth",
      "_comment": "issue #98: the Body/Face/Mouth layered machine. Advancing 1s in 0.1s frames leaves every layer in its initial state, so Body owns positionX (Idle keys it flat at 0) while Mouth's Closed clip animates only scaleX. The exhaustive per-layer pose table lives in test/fixtures/layers/body_face_mouth_poses.txt and is checked by engine/kineto_engine/tests/layers.rs and the Dart fixture test.",
      "asset": "engine/kineto_engine/tests/fixtures/body_face_mouth.kvk",
      "steps": [
        {
          "op": "load"
        },
        {
          "op": "advance",
          "deltaSeconds": 0.1
        },
        {
          "op": "advance",
          "deltaSeconds": 0.1
        },
        {
          "op": "advance",
          "deltaSeconds": 0.1
        },
        {
          "op": "advance",
          "deltaSeconds": 0.1
        },
        {
          "op": "advance",
          "deltaSeconds": 0.1
        },
        {
          "op": "advance",
          "deltaSeconds": 0.1
        },
        {
          "op": "advance",
          "deltaSeconds": 0.1
        },
        {
          "op": "advance",
          "deltaSeconds": 0.1
        },
        {
          "op": "advance",
          "deltaSeconds": 0.1
        },
        {
          "op": "advance",
          "deltaSeconds": 0.1
        },
        {
          "op": "expectOverrideScalar",
          "nodeId": "node-body",
          "key": "positionX",
          "value": 0.0
        },
        {
          "op": "expectOverrideScalar",
          "nodeId": "node-body",
          "key": "scaleX",
          "value": 1.0
        }
      ],
      "expect": {
        "loads": true,
        "advanceStatus": "ok"
      }
    },
